@{
    ViewData["Title"] = "Verify Code";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify — UP Sanction Scan Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface min-h-screen flex flex-col font-body">
    <main class="flex-1 flex items-center justify-center px-4 py-10">
        <div class="w-full max-w-md">
            <div class="text-center mb-8">
                <h1 class="font-display text-text-primary text-xl font-semibold mb-1">Two-Factor Verification</h1>
                <p class="text-text-secondary text-sm">Enter the 6-digit code from your authenticator app</p>
            </div>

            <div class="bg-surface-card border border-border rounded-2xl px-8 py-8 shadow-sm">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-error-bg border border-error-border text-error text-sm rounded-lg px-4 py-3 mb-5">
                        @Html.ValidationSummary(false)
                    </div>
                }

                <form asp-controller="Auth" asp-action="MfaVerify" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-6">
                        <label class="block text-xs text-text-secondary font-medium mb-1.5 tracking-wide">
                            Authentication code
                        </label>
                        <input type="text"
                               name="code"
                               placeholder="123456"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               required
                               class="w-full px-4 py-2.5 bg-surface border border-border rounded-lg
                        text-text-primary text-sm text-center tracking-widest
                        focus:outline-none focus:border-brand-400 focus:ring-2
                        focus:ring-brand-100 transition-colors" />
                        <p class="text-text-muted text-xs mt-2">Lost your device? Enter a recovery code instead.</p>
                    </div>

                    <button type="submit"
                            class="w-full py-2.5 bg-accent-500 hover:bg-accent-600 text-white
                        font-medium text-sm rounded-lg transition-colors shadow-sm">
                        Verify
                    </button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>